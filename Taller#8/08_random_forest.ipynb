   "source": [
    "N_OPT = int(elegida.n_arboles)\n",
    "ALPHA_OPT = float(elegida.ccp_alpha)\n",
    "\n",
    "modelo_final = RandomForestClassifier(n_estimators=N_OPT, ccp_alpha=ALPHA_OPT, random_state=SEMILLA).fit(X_train, y_train)\n",
    "modelo_base  = RandomForestClassifier(n_estimators=100, ccp_alpha=0.0, random_state=SEMILLA).fit(X_train, y_train)\n",
    "\n",
    "def resumen(nombre, m):\n",
    "    nodos = np.mean([a.tree_.node_count for a in m.estimators_])\n",
    "    return {\"modelo\": nombre, \"n_arboles\": len(m.estimators_), \"nodos_por_arbol\": nodos,\n",
    "            \"nodos_totales\": nodos * len(m.estimators_),\n",
    "            \"acc_train\": m.score(X_train, y_train), \"acc_test\": m.score(X_test, y_test)}\n",
    "\n",
    "pd.DataFrame([resumen(\"Base (100 árboles, sin poda)\", modelo_base),\n",
    "              resumen(\"Elegido\", modelo_final)]).round(4)"
   ]
  },
