   "source": [
    "camino = DecisionTreeClassifier(random_state=SEMILLA).cost_complexity_pruning_path(X_train, y_train)\n",
    "alphas_arbol = camino.ccp_alphas\n",
    "print(\"Alphas candidatos que sugiere un árbol individual:\", len(alphas_arbol))\n",
    "print(\"Mínimo:\", alphas_arbol.min().round(5), \"| Máximo (poda hasta la raíz):\", alphas_arbol.max().round(5))\n",
    "\n",
    "plt.figure(figsize=(6, 3.5))\n",
    "plt.plot(camino.ccp_alphas[:-1], camino.impurities[:-1], marker=\"o\", ms=3, drawstyle=\"steps-post\")\n",
    "plt.xlabel(\"ccp_alpha\"); plt.ylabel(\"Impureza total de las hojas\")\n",
    "plt.title(\"Más poda = más impureza (árbol más simple)\"); plt.grid(alpha=.3); plt.show()"
   ]
