      "nodos_por_arbol    243.4833\n",
      "profundidad         12.4500\n"
     ]
    }
   ],
   "source": [
    "TOLERANCIA = 0.01   # 1 punto porcentual respecto al mejor accuracy de validación\n",
    "BRECHA_MAX = 0.05   # máximo de diferencia aceptada entre train y validación\n",
    "\n",
    "def elegir_configuracion(tabla, tolerancia=TOLERANCIA, brecha_max=BRECHA_MAX):\n",
    "    mejor = tabla.loc[tabla.acc_val.idxmax()]\n",
    "    umbral = mejor.acc_val - tolerancia\n",
    "\n",
    "    candidatas = tabla[(tabla.acc_val >= umbral) & (tabla.brecha <= brecha_max)]\n",
    "    elegida = candidatas.sort_values([\"n_arboles\", \"nodos_por_arbol\"]).iloc[0]\n",
    "    return mejor, umbral, candidatas, elegida\n",
    "\n",
    "mejor, umbral, candidatas, elegida = elegir_configuracion(resultados)\n",
    "print(f\"Mejor accuracy de validación: {mejor.acc_val:.4f} (n={int(mejor.n_arboles)}, alpha={mejor.ccp_alpha})\")\n",
    "print(f\"Umbral aceptable (mejor - {TOLERANCIA}): {umbral:.4f}\")\n",
    "print(f\"Configuraciones candidatas: {len(candidatas)}\")\n",
    "print(\"\\nCONFIGURACIÓN ELEGIDA:\")\n",
    "print(elegida.round(4).to_string())"
   ]
  },
